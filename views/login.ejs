<%- include('partials/head') %>
<main class="entrar">
  <div class="entrar__caixa">
    <div class="entrar__marca"><b><%= panelTitle %></b><span>painel das páginas</span></div>
    <form class="card campos" method="post" action="/admin/login" autocomplete="on">
      <% if (error) { %><div class="aviso alerta" role="alert"><%= error %></div><% } %>
      <% if (noUsers) { %><div class="aviso alerta" role="alert">Nenhum usuário cadastrado ainda. Configure SUPERADMIN_EMAIL e SUPERADMIN_PASSWORD_HASH no servidor.</div><% } %>
      <input type="hidden" name="next" value="<%= next %>">
      <label>E-mail
        <input type="email" name="email" value="<%= email %>" autocomplete="username" required <%- email ? '' : 'autofocus' %>>
      </label>
      <label>Senha
        <span class="senha">
          <input type="password" id="senha" name="password" autocomplete="current-password" required <%- email ? 'autofocus' : '' %>>
          <button type="button" data-ver-senha="senha" aria-pressed="false" hidden>Mostrar</button>
        </span>
      </label>
      <button class="btn">Entrar</button>
    </form>
  </div>
</main>
</body>
</html>
