<% if (forced) { %>
<%- include('partials/head') %>
<main class="entrar">
  <div class="entrar__caixa">
    <div class="entrar__marca"><span class="marca__logo" aria-hidden="true"><%= panelTitle.trim().charAt(0).toUpperCase() %></span><div><b><%= panelTitle %></b><span>Painel das páginas</span></div></div>
<% } else { %>
<%- include('partials/top') %>
<div class="cabeca"><div><h1>Trocar senha</h1></div></div>
<% } %>
    <form class="card campos<%= forced ? '' : ' estreito' %>" method="post" action="/admin/conta/senha">
      <% if (forced) { %><h1>Crie a sua senha</h1><p class="mudo">Olá, <%= user.name || user.email %>. Antes de começar, troque a senha provisória por uma sua.</p><% } %>
      <% if (forced && flashWarn) { %><div class="aviso alerta" role="alert"><%= flashWarn %></div><% } %>
      <input type="text" name="username" value="<%= user.email %>" autocomplete="username" hidden>
      <% if (!forced) { %>
        <label>Senha atual <input type="password" name="current" autocomplete="current-password" required></label>
      <% } %>
      <label>Nova senha
        <span class="senha"><input type="password" id="nova" name="password" autocomplete="new-password" minlength="8" required><button type="button" data-ver-senha="nova" aria-pressed="false" hidden>Mostrar</button></span>
        <span class="ajuda">Pelo menos 8 caracteres. Uma frase curta é mais segura e mais fácil de lembrar.</span>
      </label>
      <label>Repita a nova senha <input type="password" name="confirm" autocomplete="new-password" minlength="8" required></label>
      <div class="acoes"><button class="btn"><%= forced ? 'Criar senha e entrar' : 'Trocar senha' %></button><% if (!forced) { %><a class="pequeno" href="/admin/conta">Cancelar</a><% } %></div>
    </form>
<% if (forced) { %>
    <form method="post" action="/admin/logout" style="text-align:center"><button class="btn perigo peq">Sair</button></form>
  </div>
</main>
</body>
</html>
<% } else { %>
<%- include('partials/bottom') %>
<% } %>
