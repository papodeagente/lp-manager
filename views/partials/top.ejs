<%- include('head') %>
<%
  // a cor da página aberta (a mesma da bolinha no menu) pinta os gráficos da tela
  const iCor = (typeof page !== 'undefined' && page) ? navPages.findIndex(function (p) { return p.id === page.id; }) : -1;
  const em = function (base) { return path === base || path.indexOf(base + '/') === 0; };
  const inicial = function (t) { return String(t || '?').trim().charAt(0).toUpperCase(); };
%>
<div class="app">
  <header class="barra-cel">
    <button type="button" class="icone-btn" popovertarget="lateral" aria-label="Abrir o menu"><%- icon('menu') %></button>
    <a class="marca" href="/admin"><span class="marca__logo" aria-hidden="true"><%= inicial(panelTitle) %></span><b><%= panelTitle %></b></a>
  </header>
  <nav class="lateral" id="lateral" popover aria-label="Menu do painel">
    <div class="lateral__topo">
      <a class="marca" href="/admin"><span class="marca__logo" aria-hidden="true"><%= inicial(panelTitle) %></span><span><b><%= panelTitle %></b><small>Painel das páginas</small></span></a>
      <button type="button" class="icone-btn fechar" popovertarget="lateral" popovertargetaction="hide" aria-label="Fechar o menu"><%- icon('fechar') %></button>
    </div>
    <div class="lateral__grupo">
      <a class="item" href="/admin" <%- path === '/admin' ? 'aria-current="page"' : '' %>><%- icon('painel') %><span>Visão geral</span></a>
      <a class="item" href="/admin/leads" <%- em('/admin/leads') ? 'aria-current="page"' : '' %>><%- icon('leads') %><span>Leads</span></a>
    </div>
    <% if (navPages.length) { %>
      <div class="lateral__grupo">
        <p class="lateral__rotulo">Páginas</p>
        <% navPages.forEach(function (p, i) { %>
          <a class="item" href="/admin/paginas/<%= p.id %>" <%- em('/admin/paginas/' + p.id) ? 'aria-current="page"' : '' %> title="<%= p.name %> (<%= p.domain %><%= p.path === '/' ? '' : p.path %>)"><i class="ponto <%= i < 3 ? 's' + (i + 1) : '' %>" aria-hidden="true"></i><span><%= p.name %></span></a>
        <% }) %>
      </div>
    <% } %>
    <% if (user.role === 'super') { %>
      <div class="lateral__grupo">
        <p class="lateral__rotulo">Administração</p>
        <a class="item" href="/admin/usuarios" <%- em('/admin/usuarios') ? 'aria-current="page"' : '' %>><%- icon('usuarios') %><span>Usuários</span></a>
        <a class="item" href="/admin/site" <%- em('/admin/site') ? 'aria-current="page"' : '' %>><%- icon('site') %><span>Site e arquivos</span></a>
        <a class="item" href="/admin/atividade" <%- em('/admin/atividade') ? 'aria-current="page"' : '' %>><%- icon('atividade') %><span>Atividade</span></a>
      </div>
    <% } %>
    <div class="lateral__conta">
      <details class="conta">
        <summary aria-label="Menu da conta"><span class="avatar" aria-hidden="true"><%= inicial(user.name || user.email) %></span><span class="conta__quem"><b><%= user.name || user.email %></b><small><%= user.role === 'super' ? 'Super admin' : 'Admin' %></small></span><%- icon('seletor') %></summary>
        <div class="conta__menu">
          <small><%= user.email %></small>
          <a href="/admin/conta"><%- icon('conta') %>Minha conta</a>
          <form method="post" action="/admin/logout"><button><%- icon('sair') %>Sair</button></form>
        </div>
      </details>
    </div>
  </nav>
  <main class="conteudo<%= iCor >= 0 && iCor < 3 ? ' cor-' + (iCor + 1) : '' %>" id="conteudo">
<% if (flash) { %><div class="aviso ok com-icone" role="status"><%- icon('ok') %><span><%= flash %></span></div><% } %>
<% if (flashWarn) { %><div class="aviso alerta com-icone" role="alert"><%- icon('alerta') %><span><%= flashWarn %></span></div><% } %>
