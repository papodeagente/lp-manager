<%- include('partials/top') %>
<%- include('partials/page-head') %>
<%
  const d = draft || {};
  const modelos = [
    ['Bio do Instagram', { name: 'Bio do Instagram', source: 'instagram', medium: 'social', campaign: 'perfil', content: 'bio', term: '' }],
    ['Stories', { name: 'Stories do Instagram', source: 'instagram', medium: 'social', campaign: '', content: 'stories', term: '' }],
    ['Post ou Reels', { name: 'Post do Instagram', source: 'instagram', medium: 'social', campaign: '', content: 'post', term: '' }],
    ['WhatsApp', { name: 'Mensagem no WhatsApp', source: 'whatsapp', medium: 'mensagem', campaign: '', content: '', term: '' }],
    ['Perfil no Google', { name: 'Perfil da clínica no Google', source: 'google', medium: 'organic', campaign: 'perfil-da-empresa', content: 'botao-site', term: '' }],
    ['E-mail', { name: 'E-mail', source: 'email', medium: 'email', campaign: '', content: '', term: '' }],
    ['Material impresso (QR)', { name: 'QR code impresso', source: 'impresso', medium: 'qr', campaign: '', content: '', term: '' }],
  ];
%>
<%- include('partials/period', { base: '/admin/paginas/' + page.id + '/links', resumo: 'O período vale para os números da lista de links.' }) %>

<section class="card">
  <div class="card__topo"><h2>Criar link</h2><p>Para usar fora do site: bio, stories, WhatsApp, e-mail, impresso.</p></div>
  <div class="acoes" style="margin-bottom:14px" aria-label="Modelos">
    <% modelos.forEach(function (m) { %><button type="button" class="chip" data-modelo="<%= JSON.stringify(m[1]) %>"><%= m[0] %></button><% }) %>
  </div>
  <form id="utm-form" class="campos" method="post" action="/admin/paginas/<%= page.id %>/links" data-base="<%= baseUrl %>">
    <div class="campos linha">
      <label>Nome do link <input type="text" name="name" value="<%= d.name || '' %>" required maxlength="80" placeholder="Ex.: Bio do Instagram"></label>
      <label>Origem <span class="ajuda">utm_source: de onde vem</span><input type="text" name="source" value="<%= d.source || '' %>" required list="lista-origens" placeholder="instagram"></label>
      <label>Mídia <span class="ajuda">utm_medium: tipo de tráfego</span><input type="text" name="medium" value="<%= d.medium || '' %>" required list="lista-midias" placeholder="social"></label>
      <label>Campanha <span class="ajuda">utm_campaign: o que divulga</span><input type="text" name="campaign" value="<%= d.campaign || '' %>" required placeholder="ultrassom-novembro"></label>
      <label>Conteúdo <span class="ajuda">utm_content: opcional</span><input type="text" name="content" value="<%= d.content || '' %>" placeholder="stories-1"></label>
      <label>Termo <span class="ajuda">utm_term: opcional</span><input type="text" name="term" value="<%= d.term || '' %>"></label>
    </div>
    <datalist id="lista-origens"><option value="instagram"><option value="facebook"><option value="whatsapp"><option value="google"><option value="youtube"><option value="tiktok"><option value="email"><option value="impresso"></datalist>
    <datalist id="lista-midias"><option value="social"><option value="paid_social"><option value="cpc"><option value="mensagem"><option value="email"><option value="qr"><option value="referral"><option value="organic"></datalist>
    <label>Endereço que será salvo
      <span class="copiar"><input type="text" id="utm-previa" readonly value="<%= baseUrl %>" aria-live="polite"><button type="button" class="btn sec" data-copiar="utm-previa">Copiar</button></span>
    </label>
    <div class="acoes"><button class="btn">Salvar link</button><span class="pequeno">Letras minúsculas, sem acento e sem espaço: o painel arruma sozinho.</span></div>
  </form>
</section>

<section class="card">
  <div class="card__topo"><h2>Links salvos</h2><p><%= period.label %>: acessos que chegaram pelo link e leads atribuídos a ele.</p></div>
  <% if (!links.length) { %>
    <p class="vazio">Nenhum link salvo ainda.</p>
  <% } else { %>
    <ul class="links">
      <% links.forEach(function (l) { %>
        <li>
          <b><%= l.name %></b>
          <span class="nums"><span><b class="num"><%= fmt.int(l.visits) %></b><%= l.visits === 1 ? 'acesso' : 'acessos' %></span><span><b class="num"><%= fmt.int(l.leads) %></b><%= l.leads === 1 ? 'lead' : 'leads' %></span></span>
          <span class="utm mono"><%= l.source %> / <%= l.medium %> / <%= l.campaign %><%= l.content ? ' / ' + l.content : '' %><%= l.term ? ' / ' + l.term : '' %></span>
          <span class="copiar"><input type="text" id="link-<%= l.id %>" readonly value="<%= l.url %>" aria-label="Endereço do link <%= l.name %>"><button type="button" class="btn sec peq" data-copiar="link-<%= l.id %>">Copiar</button></span>
          <form method="post" action="/admin/paginas/<%= page.id %>/links/<%= l.id %>/delete" data-confirmar="Excluir o link &quot;<%= l.name %>&quot;? Quem já tem o endereço continua chegando normalmente.">
            <button class="btn perigo peq">Excluir</button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="card">
  <details class="mais">
    <summary>Como marcar os links do jeito certo</summary>
    <ul class="dicas">
      <li>Um link para cada lugar: bio, stories, anúncio e WhatsApp com links diferentes, para saber qual traz mais contatos.</li>
      <li>Sempre os mesmos nomes: "instagram" em todos os links, nunca "Instagram" num e "ig" no outro.</li>
      <li>Nunca ponha UTM nos links entre as suas próprias páginas: isso abre uma visita nova e apaga a origem verdadeira.</li>
      <li>No Google Ads, deixe a marcação automática (gclid) ligada. O painel reconhece o anúncio mesmo sem UTM.</li>
    </ul>
    <div class="campos" style="margin-top:16px">
      <label>Google Ads: "Sufixo do URL final" em cada campanha (Configurações da campanha, Opções de URL)
        <span class="copiar"><input type="text" id="sufixo-google" readonly value="utm_source=google&amp;utm_medium=cpc&amp;utm_campaign=hipro_bsb&amp;utm_term={keyword}&amp;utm_content={creative}"><button type="button" class="btn sec" data-copiar="sufixo-google">Copiar</button></span>
        <span class="ajuda">Troque hipro_bsb pelo nome de cada campanha. {keyword} vira a palavra-chave do anúncio que foi acionada e {creative}, o id do anúncio. Se preferir um sufixo só, no nível da conta, use utm_campaign={campaignid} (o id de cada campanha) no lugar do nome fixo.</span>
      </label>
      <label>Instagram e Facebook (Gerenciador de Anúncios): campo "Parâmetros de URL"
        <span class="copiar"><input type="text" id="param-meta" readonly value="utm_source={{site_source_name}}&amp;utm_medium=paid_social&amp;utm_campaign={{campaign.name}}&amp;utm_content={{ad.name}}&amp;utm_term={{adset.name}}"><button type="button" class="btn sec" data-copiar="param-meta">Copiar</button></span>
        <span class="ajuda">O Meta preenche sozinho: ig ou fb, nome da campanha, do anúncio e do conjunto.</span>
      </label>
    </div>
  </details>
</section>
<%- include('partials/bottom') %>
